# Normalize to LF in the repository. Without this, a Windows checkout commits
# CRLF and every file shows as fully rewritten when the project is touched from
# another machine or from CI.
* text=auto eol=lf

# Binary assets — never munge these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jks binary
*.keystore binary
*.p8 binary
*.p12 binary

# Generated — collapse in diffs and exclude from language stats.
package-lock.json linguist-generated=true -diff
